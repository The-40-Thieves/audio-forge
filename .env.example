# ForgeAudio (`audio-forge`) Environment Variables
# Copy to `.env` for local development (`.env` is gitignored). Never commit real tokens or keys.

# ---------------------------------------------------------------------------
# MCP Sandbox (`forge-mcp`)
# ---------------------------------------------------------------------------
# Path-separated list of root directories `forge-mcp` may read and write via cap-std.
# Unset or empty defaults to the directory `forge-mcp` was launched from.
FORGE_MCP_ROOT=

# ---------------------------------------------------------------------------
# Stem Separation Worker Routing (`forge-worker` / `forge-cli` / `forge-daw`)
# ---------------------------------------------------------------------------
# Backend selector: auto | local_gpu | colab | dsp (default: auto)
FORGE_WORKER_BACKEND=auto

# Set to `1` or `true` to fail instead of falling back to Rust 4-stem DSP if neural separation fails.
FORGE_WORKER_REQUIRE_NEURAL=

# Optional explicit override path to `python-worker/forge_gpu_worker.py`
FORGE_GPU_WORKER_SCRIPT=

# Timeout in seconds for local Python GPU worker subprocesses
FORGE_GPU_WORKER_TIMEOUT_SECS=

# ---------------------------------------------------------------------------
# Remote Google Colab A100 / L4 Worker (`notebooks/ForgeAudio_Colab_A100_Worker.ipynb`)
# ---------------------------------------------------------------------------
# Public HTTPS URL printed by the Colab notebook (http://localhost:... permitted for local tests only).
FORGE_COLAB_WORKER_URL=

# Shared Bearer token required by both `ForgeAudio_Colab_A100_Worker.ipynb` and `forge-worker`.
FORGE_COLAB_API_TOKEN=

# Timeout in seconds for remote Colab HTTP requests
FORGE_COLAB_TIMEOUT_SECS=

# ---------------------------------------------------------------------------
# Google Gemini / Lyria Generation (`forge lyria`)
# ---------------------------------------------------------------------------
# Google AI / Gemini API key (alternatively `GOOGLE_API_KEY`)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
