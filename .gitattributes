# Normalise line endings to LF in the repository; rustfmt, ruff and CI all expect LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never diff or normalise.
*.wav  binary
*.flac binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.aiff binary
*.mid  binary
*.midi binary
*.png  binary
*.jpg  binary
*.ico  binary
*.nam  -text

# Generated or vendored files.
Cargo.lock linguist-generated=true
*.ipynb    linguist-documentation=true
